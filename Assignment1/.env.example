# ---------------------------------------------------------------------------
# Copy this file to ".env" (same folder) and paste your real keys after the "=".
# No quotes, no spaces around "=".  NEVER commit the real .env anywhere.
# ---------------------------------------------------------------------------

# Weights & Biases -> https://wandb.ai/authorize
WANDB_API_KEY=
# Your W&B username or team. Leave blank to use your personal workspace.
WANDB_ENTITY=
WANDB_PROJECT=anlp-a1-blt-ablation

# Hugging Face -> https://huggingface.co/settings/tokens  (needs "Write" role)
HF_TOKEN=
HF_USERNAME=

# Kaggle -> https://www.kaggle.com/settings  ->  "Create New Token"
# (that downloads kaggle.json which contains exactly these two values)
KAGGLE_USERNAME=
KAGGLE_KEY=
